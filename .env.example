# Copy to .env and fill in. .env is gitignored.
NEO4J_USER=neo4j
# Required: docker compose refuses to start without it. At least 8 characters.
# Only applied when the neo4j_data volume is first created; afterwards change it with
#   ALTER CURRENT USER SET PASSWORD FROM '<old>' TO '<new>'
NEO4J_PASSWORD=
NEO4J_URI=bolt://localhost:7687
COHERE_API_KEY=
