# Copy to .env and fill in. .env is gitignored.
NEO4J_USER=neo4j
# Required: docker compose refuses to start without it. At least 8 characters.
# Only applied when the neo4j_data volume is first created; afterwards change it with
#   ALTER CURRENT USER SET PASSWORD FROM '<old>' TO '<new>'
NEO4J_PASSWORD=
NEO4J_URI=bolt://localhost:7687
COHERE_API_KEY=
# Where the chat page (streamlit run src/ui/app.py) finds the API. The default below is already
# where `uvicorn src.api.main:app` listens, so set it only to point somewhere else. It must start
# with http:// or https://; a trailing slash is fine. An environment variable named API_URL wins
# over this file, and .env is read from the CURRENT folder, so start the page from the repo root.
# API_URL=http://localhost:8000
